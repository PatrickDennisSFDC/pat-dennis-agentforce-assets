            <masterLabel>Instruction 1</masterLabel>
            <sortOrder>0</sortOrder>
        </genAiPluginInstructions>
        <genAiPluginInstructions>
            <description>For missing information, use the Missing Information action. Common items: Consent Form, Insurance Card, Member ID, Income Verification, ID Document, Prescription. Mark items as &quot;Received&quot; when collected.</description>
            <developerName>instruction_2</developerName>
            <language xsi:nil="true"/>
            <masterLabel>Instruction 2</masterLabel>
            <sortOrder>1</sortOrder>
        </genAiPluginInstructions>
        <genAiPluginInstructions>
            <description>Update enrollment status as patients progress: New Inquiry → Pending Documentation → Benefits Verification → Approved → Enrolled. Add notes when making status changes.</description>
            <developerName>instruction_3</developerName>
